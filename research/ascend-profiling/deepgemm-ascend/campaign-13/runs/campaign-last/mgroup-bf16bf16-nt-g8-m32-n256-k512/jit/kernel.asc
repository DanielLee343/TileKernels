
#include <deep_gemm/bf16_gemm.hpp>

namespace deep_gemm {
static void __instantiate() {
    auto p = reinterpret_cast<void*>(&bf16_gemm_impl<
        Major::K, Major::K,
        0, 256, 512,
        256, 256, 128,
        256, 128, 64,
        4, 2,
        2,
        28,
        asc_load_l2_cache_mode::NOTALLOC_KEEP,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
        asc_store_l2_cache_mode::NOTALLOC_CLEAN,
        false,
        GemmType::MGroupedContiguousWithPsumLayout,
        bfloat16_t,
        epilogue::operators::Identity,
        256,
        false, false, false>);
}
} // namespace deep_gemm
