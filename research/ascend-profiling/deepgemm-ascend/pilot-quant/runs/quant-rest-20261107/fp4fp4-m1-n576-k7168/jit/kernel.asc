
#include <deep_gemm/fp8_gemm.hpp>

using namespace deep_gemm;
static void __instantiate() {
    auto p = reinterpret_cast<void*>(&fp8_gemm_impl<
        Major::K, Major::K,
        0, 576, 7168,
        16, 32, 4096,
        16, 32, 2048,
        4, 2,
        2, 2,
        1,
        28,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
        asc_load_l2_cache_mode::NOTALLOC_KEEP,
        asc_store_l2_cache_mode::NOTALLOC_CLEAN,
        false,
        GemmType::Normal,
        float4_e2m1x2_t,
        bfloat16_t,
        epilogue::operators::Identity,
        256,
        true, true>);
}
